{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // supabase/functions/* are Deno modules: they import from https:// URLs and
  // use the `Deno` global, neither of which this Node/browser config can
  // resolve. Deno type-checks them itself on `supabase functions deploy`.
  "exclude": [
    "node_modules",
    "dist",
    "supabase"
  ]
}
